{
  "name": "feed-gardener-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:structure": "node scripts/generate-project-structure.mjs",
    "docs:structure:check": "node scripts/generate-project-structure.mjs --check",
    "predev": "pnpm docs:structure",
    "dev": "node --experimental-sqlite node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "pnpm docs:structure",
    "build": "node --experimental-sqlite node_modules/next/dist/bin/next build",
    "start": "node --experimental-sqlite node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000",
    "cli": "node --experimental-sqlite --env-file-if-exists=.env.local --experimental-strip-types cli/main.ts",
    "pretypecheck": "pnpm docs:structure",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm docs:structure",
    "test": "node --experimental-sqlite --experimental-strip-types --test lib/*.test.ts cli/*.test.ts",
    "format": "prettier --write app components lib cli next.config.ts",
    "format:check": "prettier --check app components lib cli next.config.ts"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
